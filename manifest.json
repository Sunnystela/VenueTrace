{
  "manifest_version": 3,
  "name": "VenueTrace",
  "version": "0.1.0",
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "host_permissions": ["https://dblp.org/*"],
  "content_scripts": [
    {
      "matches": ["https://arxiv.org/abs/*"],
      "js": ["src/content/arxiv.js"]
    }
  ]
}
