{
  "manifest_version": 3,
  "name": "VenueTrace",
  "version": "0.1.0",
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "host_permissions": [
    "https://dblp.org/*",
    "https://api2.openreview.net/*",
    "https://api.crossref.org/*",
    "https://api.openalex.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://arxiv.org/abs/*"],
      "js": ["src/ui/evidence-panel.js", "src/content/arxiv.js"],
      "css": ["src/content/arxiv.css"]
    }
  ]
}
